{
  "name": "watchtower-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run types && npm run typecheck && npm test && wrangler deploy --dry-run",
    "check:frontend": "wrangler deploy --config wrangler.frontend.jsonc --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply watchtower-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply watchtower-db --remote",
    "deploy": "wrangler deploy",
    "deploy:frontend": "wrangler deploy --config wrangler.frontend.jsonc"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.13",
    "@cloudflare/workers-types": "latest",
    "@types/node": "^26.6.2",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
