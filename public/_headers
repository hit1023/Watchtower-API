/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://watchtower-api.s-quad.com; img-src 'self'; style-src 'self'; script-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'

/styles.css
  Cache-Control: no-cache

/app.js
  Cache-Control: no-cache

/mark.svg
  Cache-Control: public, max-age=31536000, immutable
